# Copy this file to .env.local (or .env) and fill in your own values.
# Never commit your real environment file.

# PostgreSQL connection string (required).
# Supabase on Vercel: use Supabase → Connect → Transaction pooler (port 6543).
# The direct connection (db.<project>.supabase.co) only works over IPv6, which Vercel doesn't support.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: connection string used by `npx drizzle-kit push` instead of DATABASE_URL
# (for example Supabase's session pooler, port 5432, if push hangs on the transaction pooler).
DIRECT_URL=

# Recommended in production: your database's CA certificate (PEM) for full SSL verification.
# Supabase: Database Settings → SSL Configuration → Download certificate. Remote databases always use SSL;
# without this the connection is encrypted but the certificate isn't verified.
DATABASE_CA_CERT=

# Optional: set to "disable" only for a remote database that doesn't support SSL.
DATABASE_SSL=

# Optional: maximum database connections per server instance (default 5).
DATABASE_POOL_MAX=

# Password for the leads dashboard at /admin (required, at least 8 characters — 14+ recommended).
ADMIN_PASSWORD=change-me-to-a-strong-password

# Recommended: long random string used to sign admin sessions. Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Public URL of the site, used for the sitemap, robots.txt and social previews
NEXT_PUBLIC_SITE_URL=https://0daysecurity.tech

# Optional: email alerts for new quote requests (https://resend.com)
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
QUOTE_FROM_EMAIL=
