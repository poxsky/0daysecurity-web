# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Password for the leads dashboard at /admin (required, at least 8 characters)
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: long random string used to sign admin sessions
ADMIN_SESSION_SECRET=

# Public URL of the site, used for the sitemap, robots.txt and social previews
NEXT_PUBLIC_SITE_URL=https://0daysecurity.tech

# Optional: email alerts for new quote requests (https://resend.com)
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=
QUOTE_FROM_EMAIL=
